{
  "graph": "universal.json",
  "loader_shape": "unet",
  "prompt_transform": "none",
  "latent_class": "EmptyLatentImage",
  "toggles": {
    "negpip": false,
    "model_sampling": true
  },
  "model_sampling": {
    "shift_start": 2.02,
    "shift_end": 2.02,
    "start_percent": 0.0,
    "end_percent": 1.0,
    "curve": "ease_in",
    "outside_window": "hold",
    "multiplier": 1.0
  },
  "defaults": {
    "steps": 28,
    "cfg": 4.0,
    "sampler_name": "euler",
    "scheduler": "simple",
    "denoise": 1.0,
    "add_noise": true
  },
  "resolution": {
    "megapixels": 1.0,
    "multiple": 16,
    "aspect": "1:1"
  },
  "lora": {
    "aliases": {},
    "loader": "LoraLoaderModelOnly"
  },
  "id": "flux2",
  "label": "Flux 2 Klein",
  "detect": "flux2",
  "text_encoder": {
    "te_model": "QWEN3_8B",
    "clip_type": "flux2",
    "clip_type_significant": true,
    "hidden": 4096,
    "match": "base.context_in == te.hidden * 3"
  },
  "vae": {
    "arch": "flux2",
    "prefer": [
      "flux2-vae.safetensors"
    ]
  },
  "int8": {
    "model_type": "flux2"
  }
}
