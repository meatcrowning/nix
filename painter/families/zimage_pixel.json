{
  "graph": "universal.json",
  "loader_shape": "unet",
  "prompt_transform": "none",
  "latent_class": "EmptyChromaRadianceLatentImage",
  "toggles": {
    "negpip": false,
    "model_sampling": true
  },
  "model_sampling": {
    "shift_start": 3.0,
    "shift_end": 3.0,
    "start_percent": 0.0,
    "end_percent": 1.0,
    "curve": "ease_in",
    "outside_window": "hold",
    "multiplier": 1.0
  },
  "defaults": {
    "steps": 30,
    "cfg": 3.5,
    "sampler_name": "euler",
    "scheduler": "simple",
    "denoise": 1.0,
    "add_noise": true
  },
  "resolution": {
    "megapixels": 1.0,
    "multiple": 64,
    "aspect": "1:1"
  },
  "lora": {
    "aliases": {
      "to_out.0": "out",
      "to_q": "qkv",
      "to_k": "qkv",
      "to_v": "qkv"
    },
    "loader": "LoraLoaderModelOnly"
  },
  "id": "zimage_pixel",
  "label": "Z-Image (pixel space)",
  "detect": "zimage_pixel",
  "text_encoder": {
    "te_model": "QWEN3_4B",
    "clip_type": "lumina2",
    "clip_type_significant": true,
    "hidden": 2560
  },
  "vae": {
    "arch": "pixel_space",
    "prefer": [
      "pixel_space_vae_stub.safetensors"
    ]
  }
}
