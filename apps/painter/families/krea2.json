{
  "graph": "universal.json",
  "loader_shape": "unet",
  "prompt_transform": "none",
  "latent_class": "EmptyLatentImage",
  "toggles": {
    "negpip": false,
    "model_sampling": false
  },
  "model_sampling": {},
  "defaults": {
    "steps": 8,
    "cfg": 1.0,
    "sampler_name": "euler",
    "scheduler": "simple",
    "denoise": 1.0,
    "add_noise": true,
    "system_prompt": "Describe the image by detailing the color, shape, size, texture, quantity, text, spatial relationships of the objects and background:",
    "krea_sampling": "native",
    "krea_shift": 1.15,
    "reference_megapixels": 0.25
  },
  "resolution": {
    "megapixels": 1.0,
    "multiple": 16,
    "aspect": "2:3"
  },
  "lora": {
    "aliases": {
      "text_fusion": "txtfusion",
      "transformer_blocks.": "blocks.",
      "ff.": "mlp.",
      "to_out.0": "wo",
      "to_q": "wq",
      "to_k": "wk",
      "to_v": "wv",
      "to_gate": "gate"
    },
    "loader": "LoraLoaderModelOnly"
  },
  "id": "krea2",
  "label": "Kroma / Krea 2",
  "detect": "krea2",
  "text_encoder": {
    "te_model": "QWEN3VL_4B",
    "clip_type": "krea2",
    "clip_type_significant": true,
    "hidden": 2560,
    "match": "base.txtdim == te.hidden"
  },
  "vae": {
    "arch": "wan21",
    "prefer": [
      "qwen_image_vae.safetensors"
    ]
  },
  "int8": {
    "model_type": "krea2",
    "enable_convrot": true,
    "on_the_fly_quantization": false,
    "lora_mode": "None"
  },
  "variants": {
    "turbo": {
      "steps": 8,
      "cfg": 1.0
    }
  },
  "supports_patches": false,
  "reference_images": true,
  "encoder_controls": true
}
