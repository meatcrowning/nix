{
  "_comment": [
    "The single text-to-image graph painter submits for every family.",
    "Per-model differences are values, optional nodes, or a node-class swap at one",
    "role -- never a different template.  `painter_role` names each slot;",
    "`painter_bypass` maps an output index to the input that replaces it when the",
    "node is toggled off, which is how NegPip and ModelSampling are removed cleanly."
  ],
  "1": {
    "inputs": { "unet_name": "", "weight_dtype": "default" },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model", "painter_role": "loader" }
  },
  "2": {
    "inputs": { "clip_name": "", "type": "stable_diffusion", "device": "default" },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load CLIP", "painter_role": "clip" }
  },
  "3": {
    "inputs": { "vae_name": "" },
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE", "painter_role": "vae" }
  },
  "40": {
    "inputs": { "model": ["1", 0], "clip": ["2", 0] },
    "class_type": "CLIPNegPip",
    "_meta": {
      "title": "CLIP NegPip",
      "painter_role": "negpip",
      "painter_optional": true,
      "painter_bypass": { "0": "model", "1": "clip" }
    }
  },
  "39": {
    "inputs": {
      "model": ["40", 0],
      "shift_start": 3.5,
      "shift_end": 1.2,
      "start_percent": 0.0,
      "end_percent": 0.5,
      "curve": "ease_in",
      "outside_window": "hold",
      "multiplier": 1.0
    },
    "class_type": "ModelSamplingSD3Advanced",
    "_meta": {
      "title": "Model Sampling SD3 (advanced)",
      "painter_role": "model_sampling",
      "painter_optional": true,
      "painter_bypass": { "0": "model" }
    }
  },
  "5": {
    "inputs": { "text": "", "clip": ["40", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt", "painter_role": "encode_pos" }
  },
  "6": {
    "inputs": { "text": "", "clip": ["2", 0] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt", "painter_role": "encode_neg" }
  },
  "41": {
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Empty Latent Image", "painter_role": "latent" }
  },
  "11": {
    "inputs": { "sampler_name": "euler" },
    "class_type": "KSamplerSelect",
    "_meta": { "title": "Sampler", "painter_role": "sampler_select" }
  },
  "14": {
    "inputs": { "scheduler": "simple", "steps": 20, "denoise": 1.0, "model": ["39", 0] },
    "class_type": "BasicScheduler",
    "_meta": { "title": "Scheduler", "painter_role": "scheduler" }
  },
  "4": {
    "inputs": {
      "add_noise": true,
      "noise_seed": 0,
      "cfg": 1.0,
      "model": ["39", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "sampler": ["11", 0],
      "sigmas": ["14", 0],
      "latent_image": ["41", 0]
    },
    "class_type": "PainterSamplerCustom",
    "_meta": { "title": "Sampler", "painter_role": "sampler" }
  },
  "8": {
    "inputs": { "samples": ["4", 0], "vae": ["3", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode", "painter_role": "decode" }
  },
  "15": {
    "inputs": { "filename_prefix": "painter", "images": ["8", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image", "painter_role": "save" }
  }
}
