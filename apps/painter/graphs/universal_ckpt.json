{
  "_comment": [
    "The one permitted template swap: bundled checkpoints carry the diffusion model,",
    "text encoder and VAE in a single file, so CheckpointLoaderSimple replaces the",
    "loader/clip/vae trio.  Everything downstream is identical to universal.json."
  ],
  "1": {
    "inputs": { "ckpt_name": "" },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load Checkpoint",
      "painter_role": "loader",
      "painter_provides": { "model": 0, "clip": 1, "vae": 2 }
    }
  },
  "40": {
    "inputs": { "model": ["1", 0], "clip": ["1", 1] },
    "class_type": "CLIPNegPip",
    "_meta": {
      "title": "CLIP NegPip",
      "painter_role": "negpip",
      "painter_optional": true,
      "painter_bypass": { "0": "model", "1": "clip" }
    }
  },
  "39": {
    "inputs": {
      "model": ["40", 0],
      "shift_start": 3.5,
      "shift_end": 1.2,
      "start_percent": 0.0,
      "end_percent": 0.5,
      "curve": "ease_in",
      "outside_window": "hold",
      "multiplier": 1.0
    },
    "class_type": "ModelSamplingSD3Advanced",
    "_meta": {
      "title": "Model Sampling SD3 (advanced)",
      "painter_role": "model_sampling",
      "painter_optional": true,
      "painter_bypass": { "0": "model" }
    }
  },
  "5": {
    "inputs": { "text": "", "clip": ["40", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt", "painter_role": "encode_pos" }
  },
  "6": {
    "inputs": { "text": "", "clip": ["1", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt", "painter_role": "encode_neg" }
  },
  "41": {
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Empty Latent Image", "painter_role": "latent" }
  },
  "11": {
    "inputs": { "sampler_name": "euler" },
    "class_type": "KSamplerSelect",
    "_meta": { "title": "Sampler", "painter_role": "sampler_select" }
  },
  "14": {
    "inputs": { "scheduler": "normal", "steps": 25, "denoise": 1.0, "model": ["39", 0] },
    "class_type": "BasicScheduler",
    "_meta": { "title": "Scheduler", "painter_role": "scheduler" }
  },
  "4": {
    "inputs": {
      "add_noise": true,
      "noise_seed": 0,
      "cfg": 6.0,
      "model": ["39", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "sampler": ["11", 0],
      "sigmas": ["14", 0],
      "latent_image": ["41", 0]
    },
    "class_type": "SamplerCustom",
    "_meta": { "title": "Sampler", "painter_role": "sampler" }
  },
  "8": {
    "inputs": { "samples": ["4", 0], "vae": ["1", 2] },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode", "painter_role": "decode" }
  },
  "15": {
    "inputs": { "filename_prefix": "painter", "images": ["8", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image", "painter_role": "save" }
  }
}
