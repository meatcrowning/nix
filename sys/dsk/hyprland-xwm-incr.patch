+// next chunk is only read once the previous one has been written out: the
+// property is deleted on read, which is what tells the owner to send more.
+// SXTransfer::propertySet  = the SelectionNotify for this transfer has arrived
+// SXTransfer::flushOnDelete = a new chunk arrived while the last was still
+//                             being written; read it when that write finishes
+static void incomingRead(SXSelection& sel, SXTransfer* t);
+static void incomingErase(SXSelection& sel, SXTransfer* t) {
+    std::erase_if(sel.transfers, [t](const auto& x) { return x.get() == t; });
+}
+static SXTransfer* incomingFind(SXSelection& sel, xcb_window_t w) {
+    auto it = std::ranges::find_if(sel.transfers, [w](const auto& x) { return x->incomingWindow && x->incomingWindow == w; });
