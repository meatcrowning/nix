+}
+// Write t's pending property bytes to its pipe; on completion move on to the
+// next chunk (INCR) or finish the transfer (EOF for the reader).
+static void incomingWrite(SXSelection& sel, SXTransfer* t) {
+    if (!t->propertyReply)
+        return;
+
+    auto* property  = sc<char*>(xcb_get_property_value(t->propertyReply));
+    int   remainder = xcb_get_property_value_length(t->propertyReply) - t->propertyStart;
+
+    while (remainder > 0) {
+        ssize_t len = write(t->wlFD.get(), property + t->propertyStart, remainder);
+        if (len < 0) {
+            if (errno == EINTR)
+                continue;
+            if (errno == EAGAIN) {
+                if (!t->eventSource)
+                    t->eventSource = wl_event_loop_add_fd(g_pCompositor->m_wlEventLoop, t->wlFD.get(), WL_EVENT_WRITABLE, ::writeDataSource, &sel);
+                return;
+            }
+            Log::logger->log(Log::ERR, "[xwm] write died in transfer get");
+            incomingErase(sel, t);
+            return;
