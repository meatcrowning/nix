@@ -100,7 +100,8 @@
 
 bool DecoratedWindowImpl::isShadeable() const
 {
-    return false;
+    // Anything the user can resize can be rolled up into its titlebar.
+    return m_window->isResizable();
 }
 
 #define DELEGATE(type, name, clientName)   \
@@ -129,7 +130,7 @@
 
 bool DecoratedWindowImpl::isShaded() const
 {
-    return false;
+    return m_shaded;
 }
 
 #define DELEGATE(type, name, clientName)   \
@@ -146,6 +147,32 @@
 
 void DecoratedWindowImpl::requestToggleShade()
 {
+    if (m_window->isDeleted() || !m_window->isResizable()) {
+        return;
+    }
+
+    if (!m_shaded) {
+        // Everything but the decoration's top border rolls away. A window with
+        // no top border (client-side decorations) has nothing to roll into.
+        const qreal bar = m_window->clientGeometry().y() - m_window->frameGeometry().y();
+        if (bar < 1) {
+            return;
+        }
+        m_shadeRestoreHeight = m_window->frameGeometry().height();
+        m_shaded = true;
+        // Tell the decoration first: it drops its bottom border while shaded,
+        // so the height computed below is the whole of what is left.
+        Q_EMIT decoratedWindow()->shadedChanged(true);
+        RectF geometry = m_window->frameGeometry();
+        geometry.setHeight(bar);
+        m_window->moveResize(geometry);
+    } else {
+        m_shaded = false;
+        Q_EMIT decoratedWindow()->shadedChanged(false);
+        RectF geometry = m_window->frameGeometry();
+        geometry.setHeight(m_shadeRestoreHeight);
+        m_window->moveResize(geometry);
+    }
 }
 
 #define DELEGATE(name, op)                                                \
