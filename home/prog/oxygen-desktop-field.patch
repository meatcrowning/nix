 //____________________________________________________________________
+QRect Helper::panelWorkArea()
+{
+    // Read once. A panel that changes thickness is a new render for the
+    // panels and a restart for the applications.
+    static const QRect area = [] {
+        QString state = qEnvironmentVariable("XDG_STATE_HOME");
+        if (state.isEmpty()) {
+            state = QDir::homePath() + QStringLiteral("/.local/state");
+        }
+
+        QFile file(state + QStringLiteral("/plasma-panel-workarea"));
+        if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+            return QRect();
+        }
+
+        const QList<QByteArray> fields = file.readLine(64).simplified().split(' ');
+        if (fields.size() != 4) {
+            return QRect();
+        }
+
+        int value[4];
+        for (int i = 0; i < 4; ++i) {
+            bool ok = false;
+            value[i] = fields[i].toInt(&ok);
+            if (!ok) {
+                return QRect();
+            }
+        }
+
+        const QRect published(value[0], value[1], value[2], value[3]);
+        return published.isValid() ? published : QRect();
+    }();
+
+    return area;
+}
+
+//____________________________________________________________________
+QRectF Helper::desktopFieldRect(const QScreen *screen, const QPoint &inset)
+{
+    const QRect area = panelWorkArea();
+    if (!screen || !area.isValid()) {
+        return QRectF();
+    }
+
+    return QRectF(screen->geometry().translated(-area.topLeft() - inset));
+}
+
