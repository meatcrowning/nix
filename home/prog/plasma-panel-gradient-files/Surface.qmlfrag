    Item {
        // One field in screen coordinates: the first 34px are the empty
        // window/titlebar tint, and the rest is its opaque Background base.
        // Thus the top and left panels meet at the same actual pixels.
        id: unifiedPanelSurface
        visible: opaqueItem.visible
        opacity: panelOpacity
        anchors.fill: floatingTranslucentItem

        Rectangle {
            anchors.fill: parent
            color: Kirigami.Theme.backgroundColor
        }
        Rectangle {
            anchors.fill: parent
            gradient: Gradient {
                GradientStop {
                    position: 0
                    color: Qt.rgba(1, 1, 1, Math.max(0, Math.min(0.43, 0.43 * (1 - panel.y / 34))))
                }
                GradientStop {
                    position: Math.max(0, Math.min(1, (34 - panel.y) / Math.max(1, unifiedPanelSurface.height)))
                    color: "transparent"
                }
                GradientStop { position: 1; color: "transparent" }
            }
        }
    }
