    // The panel's image has to change its URL when a new palette has been
    // rendered: Image deliberately caches a stable file URL, even with
    // cache:false.  The renderer publishes this content generation only after
    // atomically replacing the PNG.  FolderListModel is backed by a directory
    // watcher, so the serial's modification time changes the query string
    // without polling or spawning a process.  QML then reloads this
    // already-mapped Image in place.  It must never restart plasmashell: that
    // turns a colour change into a panel teardown and was the source of the
    // old 65-second delay.
    FolderListModel {
        id: panelSurfaceGeneration
        folder: "file:///home/lam/.local/state"
        nameFilters: [ "plasma-panel-surface.serial" ]
        showDirs: false
    }

    Image {
        // This is a crop of ONE screen-sized, real Oxygen window background.
        // Both panels therefore take their pixels from the same field: where
        // they meet, the tint and gradient continue without a seam. Keep it
        // fully present instead of tying it to Plasma's adaptive opacity: the
        // opaque/fullscreen face is the intended panel face at every time.
        //
        // Keep this at the default z.  Plasma creates the containment (the
        // applets) after this root component, so it remains behind every icon
        // and label while replacing the invisible opaque FrameSvg above.
        id: unifiedPanelSurface
        visible: root.floatingness === 0
        opacity: 1
        anchors.fill: floatingTranslucentItem
        source: "file:///home/lam/.local/state/plasma-panel-surface.png?generation="
                + (panelSurfaceGeneration.count === 1
                   ? panelSurfaceGeneration.get(0, "fileModified") : "0")
        sourceClipRect: Qt.rect(Math.round(panel.x), Math.round(panel.y),
                                Math.round(width), Math.round(height))
        fillMode: Image.Pad
        cache: false
    }

    // Oxygen window slabs finish at their inner edge with a one-pixel light
    // bevel.  Keep it on the panel's content-facing edge: bottom for a top
    // panel, right for the vertical panel, so the two segments meet cleanly.
    Rectangle {
        visible: opaqueItem.visible
        opacity: panelOpacity * 0.18
        color: "white"
        anchors.bottom: root.verticalPanel ? undefined : floatingTranslucentItem.bottom
        anchors.right: root.verticalPanel ? floatingTranslucentItem.right : undefined
        anchors.left: root.verticalPanel ? undefined : floatingTranslucentItem.left
        anchors.top: root.verticalPanel ? floatingTranslucentItem.top : undefined
        width: root.verticalPanel ? 1 : floatingTranslucentItem.width
        height: root.verticalPanel ? floatingTranslucentItem.height : 1
    }
