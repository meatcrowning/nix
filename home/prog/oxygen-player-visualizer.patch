+
+void Decoration::renderPlayerVisualizer(QPainter *painter, const QPalette &palette, const QRect &rect) const
+{
+    QFile state(QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation) + QStringLiteral("/player-visualizer.json"));
+    if (!state.open(QIODevice::ReadOnly)) return;
+    const auto levels = QJsonDocument::fromJson(state.readAll()).object().value(QStringLiteral("levels")).toArray();
+    const QColor color = fontColor(palette);
+    for (qsizetype i = 0; i < levels.size(); ++i) {
+        const int left = rect.left() + (rect.width() * i) / levels.size();
+        const int right = rect.left() + (rect.width() * (i + 1)) / levels.size() - 1;
+        const qreal level = std::clamp(levels.at(i).toDouble() / 100.0, 0.0, 1.0);
+        const int height = qMax(1, qRound(rect.height() * std::pow(level, 0.55)));
+        painter->fillRect(QRect(left, rect.bottom() - height + 1, qMax(1, right - left + 1), height), color);
+    }
 }
 
