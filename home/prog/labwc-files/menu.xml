<?xml version="1.0"?>
<!--
  labwc root menu. labwc 0.20 has NO built-in fallback menu: with no menu.xml
  anywhere, a right-click on the desktop logs "no menu with id 'root-menu'"
  and nothing opens — which is why the session looked bare and Reconfigure was
  unreachable. Seeded once by home-manager (home/prog/labwc.nix); the live copy
  in ~/.config/labwc is yours to edit.

  The application list is a PIPE MENU: labwc runs labwc-menu-generator every
  time the submenu is opened, so the list follows what is installed without
  anything regenerating a file. Reference: labwc-menu(5).
-->
<openbox_menu>

  <!-- Window menu (titlebar right-click / Alt-Space). Mirrors the actions the
       desktop's own titlebar offers, in the same order. -->
  <menu id="client-menu">
    <item label="Minimize">
      <action name="Iconify" />
    </item>
    <item label="Maximize">
      <action name="ToggleMaximize" />
    </item>
    <item label="Fullscreen">
      <action name="ToggleFullscreen" />
    </item>
    <item label="Roll Up/Down">
      <action name="ToggleShade" />
    </item>
    <item label="Always on Top">
      <action name="ToggleAlwaysOnTop" />
    </item>
    <menu id="client-send-to-menu" label="Send to..." />
    <separator />
    <item label="Close">
      <action name="Close" />
    </item>
  </menu>

  <menu id="root-menu">
    <item label="Terminal">
      <action name="Execute" command="kitty" />
    </item>
    <menu id="applications" label="Applications" execute="labwc-menu-generator -p -I" />
    <separator />
    <item label="Appearance...">
      <action name="Execute" command="labwc-tweaks" />
    </item>
    <item label="Reconfigure">
      <action name="Reconfigure" />
    </item>
    <separator />
    <item label="Log Out">
      <action name="If">
        <prompt message="Log out of labwc?" />
        <then>
          <action name="Exit" />
        </then>
      </action>
    </item>
  </menu>

</openbox_menu>
