# Oxygen Dark Flat — OxygenDark with the unfocused look BAKED IN.
#
# OxygenDark ships [ColorEffects:Inactive] ColorEffect=1 (desaturate) with
# ColorAmount=-0.9, i.e. KColorUtils::darken(c, 0.0, 1.9): same luma, chroma
# x1.9. That is why an unfocused window here reads as a BRIGHTER blue than the
# focused one — and it is the colour he wants on every window, focused or not
# (2026-08-24). There is no [ColorEffects:Active] to mirror it with, so the
# boosted values are written into the scheme itself and the inactive effect is
# switched OFF: every Background*/Decoration* below is the OxygenDark value put
# through that same chroma x1.9, so what used to be the unfocused palette is now
# the only palette.
#
# Foreground* are NOT boosted. The inactive effect also tinted text toward the
# background (ContrastEffect=2, 0.25) — that is the greying he explicitly did
# not want; body text stays the active near-white, and [WM] *Foreground is a
# flat white on both states so the titlebar title matches it.
#
# Regenerate: home/prog/plasma-colors.nix names the maths; the source values are
# kdePackages.oxygen's OxygenDark.colors.
[ColorEffects:Disabled]
ChangeSelectionColor=
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
Enable=
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=-0.9
ColorEffect=1
ContrastAmount=0.25
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

