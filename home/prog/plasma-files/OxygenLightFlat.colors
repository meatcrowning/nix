# Oxygen Light Flat — Oxygen with the unfocused look baked in.
#
# This is the light counterpart to OxygenDarkFlat.  It keeps Oxygen's light
# surfaces and dark text, but disables the inactive colour effect so a window
# does not change palette when it loses focus.  plasma-scheme.py moves only the
# wallpaper-derived hue family; contrast and semantic colours remain Oxygen's.
[ColorEffects:Disabled]
ChangeSelectionColor=
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
Enable=
IntensityAmount=0.1
IntensityEffect=2

