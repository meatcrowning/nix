# Oxygen Light Flat — Oxygen with the unfocused look baked in.
#
# This is the light counterpart to OxygenDarkFlat.  It keeps Oxygen's light
# surfaces and dark text, but disables the inactive colour effect so a window
# does not change palette when it loses focus.  plasma-scheme.py moves only the
# wallpaper-derived hue family; contrast and semantic colours remain Oxygen's.
#
# [Colors:View] IS DARKER THAN [Colors:Window], unlike stock Oxygen, where it is
# white. That group is this desktop's INSET surface in three separate places at
# once — `bgAlt` in every app's twelve-token palette (kdetheme.py),
# QPalette.Base behind a results pane, and the slab/hole stops surfer's 4chan
# re-skin imitates (kdetheme.py `kde_chrome`) — and an inset here is a WELL: on
# OxygenDarkFlat the view sits ~0.034 of HLS lightness BELOW the window, and
# every app is drawn on that reading. A stock light scheme inverts it, so the
# same panel becomes a raised slab brighter than the chrome above it: measured
# 2026-09-05, Oxygen's window gradient runs 222 at the titlebar down to 184 at
# the foot of the window while a white view sat at 255, which is why "the
# titlebar is dimmer than the top part of the window" and why the viewer, the
# chat prompt and the thread watcher glared. The same lightness step as the
# dark scheme's puts it back — and unlike white it has the saturation to take
# the wallpaper's hue.
[ColorEffects:Disabled]
ChangeSelectionColor=
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
Enable=
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=-0.9
ColorEffect=1
ContrastAmount=0.25
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

# SURFACE TINT. Every Background* below is held at HLS saturation 0.30 rather
# than Oxygen's near-neutral greys (Window was 214,210,208 — chroma 6/255, i.e.
# effectively no colour). plasma-scheme.py replaces the HUE with the wallpaper
# accent's and keeps lightness, so the saturation set here is the only thing
# deciding how strongly the light theme carries the wallpaper's colour.
#
# It lives in the template, not in the minted ~/.local/share/color-schemes copy,
# because that copy is REGENERATED from this file on every mint — a tint applied
# by hand there is silently lost the next time the wallpaper or accent changes
# (which is how it was lost on 2026-09-05). Raise or lower the 0.30 here.
#
# The tint only ever RAISES saturation. Values already more saturated than the
# target keep theirs (Tooltip/BackgroundAlternate is fully saturated on purpose).
#
# Lightness is untouched for every value, so all the relationships the comments
# above defend — View sitting below Window, Button above it — survive exactly.
[Colors:Button]
BackgroundAlternate=233,223,213
BackgroundNormal=231,220,210
DecorationFocus=58,167,221
DecorationHover=110,214,255
ForegroundActive=146,76,157
ForegroundInactive=137,136,135
ForegroundLink=0,87,174
ForegroundNegative=191,3,3
ForegroundNeutral=176,128,0
ForegroundNormal=34,31,30
ForegroundPositive=0,110,40
ForegroundVisited=100,74,155

# [Colors:Complementary] IS THE PANEL. Plasma resolves a panel's Plasma-style
# SVG against this group, not [Colors:Window] — so this group alone decides what
# the panel looks like. Oxygen ships it as the INVERTED group (near-black
# background, near-white ink) and plasma-scheme.py preserves that structure, so
# on the light scheme the panel came out black however the Plasma style was
# drawn: the oxygen-scheme style's gradients and accent tint were all painting
# on top of a near-black base and could not be seen. Measured 2026-09-05.
#
# It is set to the [Colors:Window] values, which in both templates are exactly
# the [WM] activeBackground/activeForeground pair — so the panel is the same
# surface as a titlebar, which is what he asked for. Keep the two in step: if
# this group and [WM] drift apart, the panel stops matching the titlebars.
[Colors:Complementary]
BackgroundAlternate=228,217,206
BackgroundNormal=224,207,198
DecorationFocus=58,167,221
DecorationHover=110,214,255
ForegroundActive=146,76,157
ForegroundInactive=137,136,135
ForegroundLink=0,87,174
ForegroundNegative=191,3,3
ForegroundNeutral=176,128,0
ForegroundNormal=34,31,30
ForegroundPositive=0,110,40
ForegroundVisited=100,74,155
[Colors:Selection]
BackgroundAlternate=62,138,204
BackgroundNormal=67,172,232
DecorationFocus=58,167,221
DecorationHover=110,214,255
ForegroundActive=108,36,119
ForegroundInactive=199,226,248
ForegroundLink=0,49,110
ForegroundNegative=156,14,14
ForegroundNeutral=255,221,0
ForegroundNormal=255,255,255
