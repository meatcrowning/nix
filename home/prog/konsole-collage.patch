+
+void SessionController::makeImageCollage()
+{
+    if (view() == nullptr || view()->screenWindow() == nullptr) {
+        return;
+    }
+    const QString selection = view()->screenWindow()->selectedText(Screen::PreserveLineBreaks);
+    const QString directory = url().isLocalFile() ? url().toLocalFile() : QDir::homePath();
+    if (selection.isEmpty() || directory.isEmpty()) {
+        return;
+    }
+    QProcess::startDetached(QStringLiteral("konsole-collage"),
+                            {QStringLiteral("--cwd"), directory, selection});
+}
